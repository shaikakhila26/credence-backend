# Supabase project settings (Settings → API in your Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this in frontend
SUPABASE_ANON_KEY=your-anon-public-key            # used only to mint phone-login sessions

# Server
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# External free API
RAZORPAY_IFSC_BASE=https://ifsc.razorpay.com
